# runmeter has no secrets and no external services. These are optional.

# Where the SQLite telemetry store lives. Default: ~/.runmeter/runmeter.db
# RUNMETER_DB_PATH=/Users/you/.runmeter/runmeter.db

# Optional JSON file overriding/extending the built-in per-model pricing table.
# Values are USD per 1,000,000 tokens: { "model": {"input": 3.0, "output": 15.0} }
# RUNMETER_PRICING=/Users/you/.runmeter/pricing.json
